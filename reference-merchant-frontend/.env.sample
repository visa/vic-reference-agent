# Shared secret added as X-Api-Key on calls to the merchant backend. It is NOT
# baked into the browser bundle: the Vite dev server (development) and the nginx
# reverse proxy (production) inject it server-side. Must match MERCHANT_API_KEY
# in the merchant backend's environment.
#
# For a local (non-Docker) run: copy this file to `.env` and fill in the value;
# `npm run dev` reads it from the environment to configure the dev proxy.
# (Under docker-compose this is supplied from the repo-root .env instead.)
MERCHANT_API_KEY=

# Optional: override the backend the dev proxy forwards /api to.
# MERCHANT_BACKEND_URL=http://localhost:8001
